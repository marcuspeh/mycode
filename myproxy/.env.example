# Provider API keys. Comma-separated; the proxy round-robins requests
# across the configured keys. A provider is enabled when its list is non-empty.
# Leave a line commented out to disable that provider.
MINIMAX_API_KEYS=sk-aaa,sk-bbb,sk-ccc
DEEPSEEK_API_KEYS=sk-aaa,sk-bbb

# Optional overrides
# MYPROXY_CONFIG_DIR=/path/to/config
# MYPROXY_HOST=0.0.0.0
# MYPROXY_PORT=8000

# Request/response traffic log (scrubbed, human-readable .txt).
# PAYLOAD_LOG_ENABLED=true
# PAYLOAD_LOG_FILE=logs/myproxy-traffic.txt
# PAYLOAD_LOG_MAX_BYTES=52428800
# PAYLOAD_LOG_BACKUPS=1
